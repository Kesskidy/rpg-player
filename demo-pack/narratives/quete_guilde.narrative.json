        },
        {
          "id": "ch_remind",
          "label": "Où se trouve l’entrée du donjon ?",
          "nextNodeId": "n_hint"
        },
        {
          "id": "ch_bye",
          "label": "Je vais me préparer d’abord.",
          "nextNodeId": "n_end"
        }
      ]
    },
    {
      "id": "n_give_potion",
